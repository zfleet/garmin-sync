# Copier en `.env` (jamais commité, jamais collé dans le chat) puis remplir.
# chmod 600 .env

# --- Garmin (requis à la première connexion seulement, ensuite les tokens suffisent) ---
GARMIN_EMAIL=
GARMIN_PASSWORD=
TOKENSTORE=~/.garminconnect

# --- Date à synchroniser (défaut : hier, journée complète) ---
# SYNC_DATE=2026-10-08

# --- Transport : file | ntfy | email | gmail ---
TRANSPORT=file

# file : dossier de sortie des JSON (un fichier par jour)
OUTPUT_DIR=/home/pi/garmin-sync/out

# ntfy : URL du serveur + topic (topic long et aléatoire si ntfy.sh public)
# NTFY_URL=https://ntfy.sh
# NTFY_URL=http://192.168.1.X:8080        # ntfy auto-hébergé sur ton réseau
# NTFY_TOPIC=garmin-teddy-xxxxxxxxxxxxxxxx
# NTFY_USER=                                # seulement si ton ntfy demande une auth
# NTFY_PASS=

# email : le Pi envoie le résumé + JSON en pièce jointe via Gmail SMTP
#         ⚠️ 2026-10-15 : SMTP bloqué au niveau réseau chez Teddy (587/465,
#         bannière jamais reçue) — transport conservé au cas où, voir 'gmail'.
# EMAIL_TO=ton-compte-dedie@gmail.com
# SMTP_USER=ton-compte-dedie@gmail.com
# SMTP_PASS=aaaa-bbbb-cccc-dddd   # mot de passe d'application Google (2FA requis
#                                 # sur le compte) — jamais dans le chat, jamais dans git

# gmail : même courriel que 'email', mais via l'API Gmail (OAuth) en HTTPS (443).
#         Contourne le blocage SMTP. Voir README « Transport gmail (API Gmail) ».
# GMAIL_ACCOUNT=ton-compte-dedie@gmail.com
# GMAIL_CLIENT_SECRET=/home/pi/garmin-sync/client_secret.json   # chmod 600
# GMAIL_TOKEN=/home/pi/garmin-sync/token.json                   # créé au 1er run, chmod 600
